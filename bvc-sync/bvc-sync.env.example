# =========================================================
# bvc-sync — Windows-side biometric bridge configuration
# =========================================================
# Copy this file to bvc-sync.env (same folder as bvc_sync.py)
# and fill in real values. The .env file MUST NOT be committed
# to git — it contains a shared API secret.
# =========================================================

# ERP backend base URL — Ubuntu server FastAPI
BACKEND_URL=http://192.168.1.10:8001

# Shared secret. MUST match ESSL_BRIDGE_API_KEY set in the
# backend's .env on the Ubuntu server. Anything long and random —
# generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
API_KEY=REPLACE_WITH_LONG_RANDOM_TOKEN

# Biometric device — same values that were previously used in
# backend/.env (before we moved sync to Windows)
DEVICE_IP=192.168.1.5
DEVICE_PORT=4370
DEVICE_COMM_KEY=0
DEVICE_ID=X2008-01
VENDOR_ID=1

# 0 = actually push events to the server
# 1 = just print what would be sent (useful for the first test run)
DRY_RUN=0
