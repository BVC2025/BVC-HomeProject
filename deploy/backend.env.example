# =====================================================================
# BVC24 ERP — Backend .env (production template)
# ---------------------------------------------------------------------
# Copy to backend/.env on the server and fill in REAL values.
# NEVER commit this file once filled in. backend/.gitignore already
# excludes .env, but double-check.
# =====================================================================


# ---- Database --------------------------------------------------------
# Format: mysql+pymysql://USER:PASS@HOST:PORT/DBNAME?charset=utf8mb4
DATABASE_URL=mysql+pymysql://bvc24_app:CHANGE_ME@localhost:3306/bvc24_prod?charset=utf8mb4


# ---- JWT signing -----------------------------------------------------
# CRITICAL: generate a random 64-char string. Anyone with this can mint
# tokens that pass auth. Rotating it logs everyone out, which is fine
# on first deploy.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256


# ---- Public URLs (used in emails) -----------------------------------
# The link in leave-approval emails / onboarding invites uses these.
# Without them, approval emails contain http://localhost:5173/...
# which is unclickable from a phone.
#
# Cloudflare Tunnel architecture (deploy/cloudflared-config.example.yml):
#   FRONTEND_BASE_URL points at the frontend hostname (erp.bvc24.com)
#   BACKEND_BASE_URL  points at the backend  hostname (api.bvc24.com)
FRONTEND_BASE_URL=https://erp.bvc24.com
BACKEND_BASE_URL=https://api.bvc24.com

# ---- CORS allowlist (optional override) -----------------------------
# Comma-separated list of origins allowed to call the API. If unset,
# the backend uses a sensible default list that includes
# https://erp.bvc24.com plus localhost dev ports. Override only if you
# add extra hostnames or temporarily widen for testing.
# CORS_ALLOWED_ORIGINS=https://erp.bvc24.com,https://staging.bvc24.com


# ---- SMTP (outbound mail) -------------------------------------------
# Used for: leave approval requests to managers, decision emails to
# employees, onboarding invites, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_app_password
SMTP_FROM=BVC24 ERP <noreply@yourdomain.com>

# Optional: while testing, route every outbound mail here so you don't
# spam real managers. Leave blank in production.
EMAIL_TESTING_OVERRIDE_TO=


# ---- AI / Chatbot ---------------------------------------------------
# Leave blank to disable Gemini and use rule-based chatbot only.
# To enable: get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ---- Vendor scope ---------------------------------------------------
# If you run multiple companies on one DB. Most installs leave this at 1.
DEFAULT_VENDOR_ID=1


# ---- Bcrypt cost -----------------------------------------------------
# Higher = slower login but harder to brute-force. Default 4 is for
# dev/seed-data speed. Bump to 12 in production.
BCRYPT_ROUNDS=12


# ---- Geofence default radius (metres) -------------------------------
# Used when the admin first creates the GeofenceSettings row. After
# creation, edit via the admin UI.
GEOFENCE_DEFAULT_RADIUS_M=100


# ---- Logging level ---------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ---- Enterprise RAG AI Platform --------------------------------------
# Qdrant runs as a local Windows service (see deploy/nssm-install-qdrant.ps1),
# not Docker. Leave QDRANT_API_KEY blank for a local, unauthenticated instance.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Local embedding model (sentence-transformers), downloads on first use.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# ---- WhatsApp Cloud API (Lead AI Assistant) --------------------------
# Per-vendor Meta WhatsApp Business config lives in the DB (vendor_whatsapp_config
# table, managed from the WhatsApp Configuration settings page) — NOT here.
# These env vars only cover the encryption key protecting those DB-stored
# secrets and the automation on/off switches.
#
# CRITICAL: generate a Fernet key and never lose it — without it, every
# stored ACCESS_TOKEN/APP_SECRET is undecryptable (the Meta tokens
# themselves can always be reissued in Meta Business Manager, though).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WA_ENCRYPTION_KEY=
# Comma-separated previous key(s), only needed while rotating WA_ENCRYPTION_KEY.
WA_ENCRYPTION_KEYS_OLD=

# Master kill-switch for the WhatsApp send/receive scheduler. Set to 0 to
# stop all outbound sending and AI auto-replies — inbound webhooks still
# accept and store messages, nothing is lost, it just won't be answered.
WHATSAPP_AUTOMATION_ENABLED=1

# Tuning (defaults are sensible for most installs — rarely need changing):
WA_INBOUND_WORKERS=3
WA_DEBOUNCE_SECONDS=3
WA_WEBHOOK_EVENT_RETENTION_DAYS=7
